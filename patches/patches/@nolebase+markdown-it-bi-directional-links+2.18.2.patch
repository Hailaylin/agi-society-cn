+/**
+ * Shared relative-path fallback for bidirectional links lookup.
+ * Used by both index.cjs and index.mjs to avoid code duplication.
+ *
+ * When a wikilink like [[annual/index|text]] can't be found globally,
+ * this retries the lookup relative to the current file's directory.
+ */
+function tryRelativeFallback(originalHref, osSpecificHref, state, isRelativePath,
+                             possibleBiDirectionalLinksInCleanBaseNameOfFilePaths,
+                             possibleBiDirectionalLinksInFullFilePaths,
+                             findBiDirectionalLinksFn,
+                             dirnameFn, joinFn) {
+  // If the direct lookup already succeeded, return as-is
+  if (originalHref !== null && !(Array.isArray(originalHref) && originalHref.length === 0)) {
+    return originalHref;
+  }
+  // Not using relative paths, or no current file context
+  if (!isRelativePath || !(state && state.env && state.env.relativePath)) {
+    return originalHref;
+  }
+  // Try prepending current file's directory
+  const relHref = joinFn(dirnameFn(state.env.relativePath), osSpecificHref);
+  const relMatch = findBiDirectionalLinksFn(
+    possibleBiDirectionalLinksInCleanBaseNameOfFilePaths,
+    possibleBiDirectionalLinksInFullFilePaths,
+    relHref
+  );
+  if (relMatch !== null && !(Array.isArray(relMatch) && relMatch.length === 0)) {
+    return relMatch;
+  }
+  return originalHref;
+}
+
+module.exports = { tryRelativeFallback };
